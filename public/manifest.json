{
  "manifest_version": 3,
  "name": "TradingView Indicator Academy",
  "version": "0.2.8",
  "description": "在 TradingView 旁快速查找技術指標的繁體中文學習工具。",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["sidePanel", "storage", "activeTab"],
  "background": { "service_worker": "assets/background.js", "type": "module" },
  "action": { "default_title": "TradingView Indicator Academy", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "side_panel": { "default_path": "sidepanel.html" }
}
