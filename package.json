{
  "name": "tradingview-indicator-academy",
  "version": "0.2.8",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-windows.ps1",
    "typecheck": "tsc -b --pretty false",
